<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\OpenReflect.Core.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AlphaVSS" Version="2.0.3" ExcludeAssets="all" GeneratePathProperty="true" />
    <Reference Include="AlphaVSS.Common">
      <HintPath>$(PkgAlphaVSS)\lib\netcoreapp3.1\AlphaVSS.Common.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
